PORT=5000
JWT_SECRET=your_jwt_secret_key
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=uptime_checker

# Cron / external scheduler settings
# If unset, the /service/run-checks endpoint allows anonymous triggers.
# To require a secret, set CRON_SECRET and include it in the x-cron-secret header.
CRON_SECRET=
# When EXTERNAL_CRON=true the internal monitoring worker will be disabled
EXTERNAL_CRON=true
